# Supabase (public anon credentials used by frontend)
BAGO_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
BAGO_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
BAGO_SUPABASE_MENU_TABLE=menu_items
BAGO_SUPABASE_CUSTOMERS_TABLE=customers
BAGO_SUPABASE_ORDERS_TABLE=orders
BAGO_SUPABASE_ORDER_ITEMS_TABLE=order_items
BAGO_SUPABASE_VOUCHERS_TABLE=vouchers
BAGO_SUPABASE_STORAGE_BUCKET=menu-images
BAGO_SUPABASE_USE_STATIC_FALLBACK=false

# Checkout values that you may want to keep local
BAGO_WHATSAPP_NUMBER=+491234567890
BAGO_PAYPAL_EMAIL=owner@example.com

# Optional for seed/import scripts
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
